# Banco local (docker compose up -d). Em produção os valores vêm dos secrets da plataforma.
# DATABASE_URL: conexão da aplicação em runtime. DIRECT_URL: conexão direta, usada pelas migrations.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nomedobanco?schema=public"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/nomedobanco?schema=public"

# Autenticação e CORS (valores de teste; em produção vêm dos secrets da plataforma).
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
WEB_ORIGIN="http://localhost:4200"

# Seed de acessos (npx prisma db seed): dados de teste fictícios.
SEED_MANAGER_EMAIL="gerente@teste.local"
SEED_MANAGER_PASSWORD="Gerente@123"
SEED_OPERATOR_EMAIL="operador@teste.local"
SEED_OPERATOR_PASSWORD="Operador@123"
