# Banco local (docker compose up -d). Em produção os valores vêm dos secrets da plataforma.
# DATABASE_URL: conexão da aplicação em runtime. DIRECT_URL: conexão direta, usada pelas migrations.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nomedobanco?schema=public"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/nomedobanco?schema=public"
